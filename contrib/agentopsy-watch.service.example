# Legacy full-rescan polling service retained for compatibility.
# Prefer agentopsyd: it incrementally reads appended transcript tails and
# persists compact local state. Use this unit only when legacy report files are
# specifically required.

[Unit]
Description=Agentopsy experimental session-health polling
After=default.target

[Service]
Type=simple
ExecStart=%h/.local/bin/agentopsy --watch 300 --report-dir %h/.local/state/agentopsy
Restart=on-failure
RestartSec=10

[Install]
WantedBy=default.target
