# Experimental legacy polling service for Agentopsy v0.2.
# The roadmap replaces this with an incremental SQLite-backed daemon that reads
# only appended transcript bytes. Prefer manual CLI usage unless you explicitly
# want the current polling prototype.

[Unit]
Description=Agentopsy experimental session-health polling
After=default.target

[Service]
Type=simple
ExecStart=%h/.local/bin/agentopsy --watch 300 --report-dir %h/.local/state/agentopsy
Restart=on-failure
RestartSec=10

[Install]
WantedBy=default.target
